# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local. NEVER put a service-role key in any NEXT_PUBLIC_ variable.

# --- Supabase (needed for the Art Journal admin area) ---------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. It is safe in the browser because
# Row Level Security (see supabase/migrations) controls what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Contact form (optional) ---------------------------------------------
# Sends mail through Resend (https://resend.com). Without these, the form
# falls back to opening the visitor's email app (mailto:).
RESEND_API_KEY=
# Where messages are delivered (your inbox)
CONTACT_TO_EMAIL=
# A sender address on a domain verified in Resend. For testing: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Site (optional) ------------------------------------------------------
# Public URL of the deployed site, used for social sharing metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
